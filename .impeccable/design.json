  "narrative": {
    "northStar": "Tecnología con criterio humano",
    "overview": "Una identidad editorial cálida que acerca diseño web y soporte IT. El marfil deja respirar la información; la tinta estructura la lectura, el terracota identifica las acciones y la salvia acompaña la forma de trabajar.\n\nNewsreader aporta carácter a los títulos y Manrope mantiene claros los párrafos, la navegación y los formularios. El logo koi conserva la continuidad de marca. La composición se apoya en espacio, líneas finas y visuales acotados; los conceptos ilustrativos permanecen identificados.",
    "keyCharacteristics": [
      "Marfil, tinta, terracota y salvia con funciones claras.",
      "Títulos editoriales y controles de lectura directa.",
      "Filas de servicios y propuestas sin cajas repetidas.",
      "Profundidad puntual y movimiento breve.",
      "Contacto visible e ilustraciones honestas."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Usar el terracota de acción en botones y titulares; los enlaces de texto, las categorías y el pie editorial pequeño usan el terracota de lectura más oscuro. Mantener ambos opacos y conservar sus roles.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Usar Newsreader para títulos editoriales y Manrope para lectura, navegación y controles.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Mantener planas las superficies de contenido; las sombras separan visuales y navegación superpuestos.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** conservar el logo koi y la voz cercana en español con voseo.",
      "**Do** usar marfil como base, tinta para lectura y terracota para acciones.",
      "**Do** mantener las familias y los estados definidos por el código compartido.",
      "**Do** conservar foco visible, etiquetas persistentes y mensajes de error asociados.",
      "**Do** identificar las propuestas y las imágenes generadas como ilustrativas."
    ],
    "donts": [
      "**Don't** presentar conceptos como clientes, trabajos realizados o resultados medidos.",
      "**Don't** convertir los servicios y las propuestas en una colección de paneles con sombra.",
      "**Don't** usar la serif para campos, navegación o explicaciones técnicas.",
      "**Don't** reemplazar datos reales de contacto ni inventar enlaces sociales.",
      "**Don't** anunciar entrega de correo sin evidencia ni borrar datos después de un fallo."
    ]
  }
